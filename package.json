{
  "name": "pi-permissions",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Deterministic global bash policy and one-shot human review for Pi 1.5.2",
  "keywords": [
    "pi-package"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "bun@1.4.4",
  "pi": {
    "extensions": [
      "./src/extension.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.8",
    "@earendil-works/pi-coding-agent": "1.5.2",
    "@types/bun": "1.3.11",
    "@types/node": "24.10.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "bun test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "verify": "bun run check && bun run lint && bun test",
    "test:pi": "bun scripts/pi-smoke.ts",
    "evaluate": "bun scripts/compare-profiles.ts",
    "test:live": "bun scripts/live-contract-check.ts"
  }
}
