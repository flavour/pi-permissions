{
  "version": 1,
  "whitelist": [
    {
      "id": "inspect-this-repo",
      "exact": "git status --short",
      "cwd": "/home/example/projects/example",
      "reason": "I explicitly trust this invocation, its Git configuration and executable resolution in this directory."
    }
  ],
  "blacklist": [
    {
      "id": "push-main-manually",
      "exact": "git push origin main",
      "reason": "Run this exact push manually after review. Other spellings are not covered by this rule."
    }
  ],
  "records": false,
  "model": {
    "mode": "shadow",
    "profile": "minrule-4q-conservative",
    "maxPayloadTokens": 1024,
    "endpoint": {
      "baseUrl": "http://jetson.lan:9931",
      "model": "LiquidAI/d1-2B-GGUF:Q8_0",
      "timeoutMs": 1500
    }
  }
}
